

var INSTANT_WIN_CONDITIONS = {
    NONE: null,
    TESHI: "Teshi",
    KUTTSUKI: "Kuttsuki"
};

var MOVE_TYPES = {
    DROP: 0,
    TAKE: 1
};

var ROUND_STATES = {
    PLAY: 0,
    REDEAL: 1,
    SCORED: 2,
    DRAW: 3
};

var OPTION_DEFINITIONS = {
    PLAYER_1:           {name: 'Player 1',                      choices: ['human', 'computer'], default: 'human'},
    PLAYER_2:           {name: 'Player 2',                      choices: ['human', 'computer'], default: 'computer'},
    NUM_ROUNDS:         {name: 'Rounds',                        choices: [3, 6, 9, 12],         default: 3},
    MONTH_OR_FLOWER:    {name: 'Month or Flower names',         choices: ['month', 'flower'],   default: 'month'},
    CARD_SORT:          {name: 'Card sort order',               choices: ['suit', 'rank'],      default: 'suit'},
    SAKE_CUP_KASU:      {name: 'Sake cup as Kasu',              choices: [true, false],         default: true},
    MOON_CHERRY_VIEWING:{name: 'Moon/Cherry Blossom Viewing',   choices: [true, false],         default: true},
    MONTHLY_CARDS:      {name: 'Monthly Cards',                 choices: [true, false],         default: true},
    RANDOM_MONTH:       {name: 'Randomize Starting Month',      choices: [true, false],         default: true},
    DOUBLE_OVER_7:      {name: 'Double points over 7',          choices: [true, false],         default: false},
    OYA_KEN:            {name: 'Dealer\'s Privilege',           choices: [true, false],         default: false},
};

var options = OPTION_DEFINITIONS.map(&(local o) => o.default);

class Card{
    MONTHS: [
        'January',
        'February',
        'March',
        'April',
        'May',
        'June',
        'July',
        'August',
        'September',
        'October',
        'November',
        'December',
    ],

    FLOWERS: [
        'Pine',
        'Plum blossom',
        'Cherry blossom',
        'Wisteria',
        'Iris',
        'Peony',
        'Bush clover',
        'Pampas grass',
        'Chrysanthemum',
        'Maple',
        'Willow',
        'Paulownia',
    ],

    RANKS: [
        'Hikari',
        'Tane',
        'Tanzaku',
        'Kasu'
    ],
    
    __construct(local suit, local rank, local name){
        this.suit = suit;
        this.rank = rank;
        this.name = name;
    },
    
    __toString(){
        return "%s, %s: %s".format(
            this.getSuitName(this.suit),
            this.RANKS[this.rank],
            this.name
        );
    },
    
    getSuitName(local suit){
        return (options.MONTH_OR_FLOWER === 'month' ? this.MONTHS : this.FLOWERS)[suit];
    }
};

