    new Card(0, 0, 'Crane and Sun'),
    new Card(0, 2, 'Poetry tanzaku'),
    new Card(0, 3, 'Kasu A'),
    new Card(0, 3, 'Kasu B'),
    
    new Card(1, 1, 'Bush warbler'),
    new Card(1, 2, 'Poetry tanzaku'),
    new Card(1, 3, 'Kasu A'),
    new Card(1, 3, 'Kasu B'),
    
    new Card(2, 0, 'Curtain'),
    new Card(2, 2, 'Poetry tanzaku'),
    new Card(2, 3, 'Kasu A'),
    new Card(2, 3, 'Kasu B'),
    
    new Card(3, 1, 'Cuckoo'),
    new Card(3, 2, 'Plain tanzaku'),
    new Card(3, 3, 'Kasu A'),
    new Card(3, 3, 'Kasu B'),
    
    new Card(4, 1, 'Eight-plank bridge'),
    new Card(4, 2, 'Plain tanzaku'),
    new Card(4, 3, 'Kasu A'),
    new Card(4, 3, 'Kasu B'),
    
    new Card(5, 1, 'Butterflies'),
    new Card(5, 2, 'Blue tanzaku'),
    new Card(5, 3, 'Kasu A'),
    new Card(5, 3, 'Kasu B'),
    
    new Card(6, 1, 'Boar'),
    new Card(6, 2, 'Plain tanzaku'),
    new Card(6, 3, 'Kasu A'),
    new Card(6, 3, 'Kasu B'),
    
    new Card(7, 0, 'Full moon'),
    new Card(7, 1, 'Geese'),
    new Card(7, 3, 'Kasu A'),
    new Card(7, 3, 'Kasu B'),
    
    new Card(8, 1, 'Sake cup'),
    new Card(8, 2, 'Blue tanzaku'),
